{
  "realm": "corewebforms",
  "enabled": true,
  "sslRequired": "none",
  "bruteForceProtected": true,
  "failureFactor": 3,
  "clients": [
    {
      "clientId": "gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/signin-oidc",
        "http://127.0.0.1:8080/signin-oidc",
        "http://localhost:18080/signin-oidc",
        "http://127.0.0.1:18080/signin-oidc",
        "https://localhost:8443/signin-oidc",
        "https://127.0.0.1:8443/signin-oidc",
        "https://localhost:18443/signin-oidc",
        "https://127.0.0.1:18443/signin-oidc"
      ],
      "webOrigins": ["http://localhost:8080", "http://127.0.0.1:8080", "http://localhost:18080", "http://127.0.0.1:18080", "https://localhost:8443", "https://127.0.0.1:8443", "https://localhost:18443", "https://127.0.0.1:18443"],
      "attributes": { "post.logout.redirect.uris": "http://localhost:8080/*", "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "audience-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "gateway",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ccw-suite",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "gateway",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "tester",
      "enabled": true,
      "email": "tester@corewebforms.local",
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "localdev-tester", "temporary": false }
      ]
    },
    {
      "username": "bf-probe",
      "enabled": true,
      "email": "bf-probe@corewebforms.local",
      "firstName": "BruteForce",
      "lastName": "Probe",
      "credentials": [
        { "type": "password", "value": "bf-probe-pw", "temporary": false }
      ]
    }
  ]
}
