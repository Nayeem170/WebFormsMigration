{
  "Urls": "http://localhost:8080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "frontend": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyAndUnknown",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:02",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          },
          "Passive": {
            "Enabled": true
          }
        },
        "Destinations": {
          "frontend1": {
            "Address": "http://frontend:8081/"
          },
          "frontend2": {
            "Address": "http://frontend2:8081/"
          }
        }
      }
    },
    "Routes": {
      "frontend": {
        "ClusterId": "frontend",
        "Order": 1,
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    }
  }
}
