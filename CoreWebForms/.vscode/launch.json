{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch CoreWebForms",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/../artifacts/bin/Debug/net/net9.0/CoreWebForms.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:8081"
            }
        }
    ]
}
